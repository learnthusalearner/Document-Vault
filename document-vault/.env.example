# ──────────────────────────────────────────────
# PostgreSQL (matches docker-compose.yml defaults)
# ──────────────────────────────────────────────
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault_secret
POSTGRES_DB=document_vault
POSTGRES_PORT=5432

# Prisma DATABASE_URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://vault:vault_secret@localhost:5432/document_vault?schema=public"

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
