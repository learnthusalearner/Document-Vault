{
  "name": "document-vault",
  "version": "0.1.0",
  "description": "Document Vault — GraphQL API built with Bun, GraphQL Yoga, and Prisma",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "gendb": "prisma generate && prisma migrate dev",
    "sanity": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.0",
    "@prisma/client": "^6.19.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@vercel/node": "^7.0.0"
  }
}